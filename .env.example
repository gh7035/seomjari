# ── LLM ──────────────────────────────────────────────
# openai | gemini | anthropic | none (none이면 규칙 기반 fallback 모드)
LLM_PROVIDER=none
# Gemini 권장: gemini-3.5-flash-lite (flash 변종은 현재 전반적 overload)
LLM_MODEL=
# 실제 키 커밋 금지. 평가용은 사용 한도 설정 후 별도 제출.
LLM_API_KEY=
LLM_TIMEOUT_S=30
LLM_RETRIES=2
# gemini 진단은 문장 1회만 호출한다. 이 값은 도구 반복 루프를 남길 때의 상한이다.
AGENT_MAX_TOOL_CALLS=16

# ── 데이터 / 세션 ────────────────────────────────────
DATA_DIR=data/processed
SESSION_DB=data/sessions.sqlite3
SESSION_TTL_S=3600

# ── 공공데이터 API 키 (없어도 캐시로 동작) ─────────────────
# 제주데이터허브 projectKey → D9 방문목적별 입도객 호출용
JEJU_HUB_PROJECT_KEY=
# 공공데이터포털 인증키 → 선택 D10 지역별 관광 수요 강도
TOUR_API_KEY=

# ── API 운영 ─────────────────────────────────────────
# 쉼표로 구분된 origin. 비우면 CORS 미적용.
CORS_ORIGINS=
# IP별 분당 요청 수. 0이면 비활성.
RATE_LIMIT_PER_MIN=30

# ── 로그 ─────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
