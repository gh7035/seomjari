{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SeomjariReport",
  "type": "object",
  "required": ["summary", "target", "signals", "score", "evidence", "limitations", "map"],
  "properties": {
    "summary": { "type": "string" },
    "target": {
      "type": "object",
      "required": ["dong", "category"],
      "properties": {
        "dong": { "type": ["string", "null"] },
        "category": { "type": ["string", "null"] }
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "level", "reason"],
        "properties": {
          "name": {
            "enum": [
              "관광 의존도", "계절 변동성", "경쟁 밀도", "수요 규모",
              "유동 수요", "생존 리스크", "최근 개폐업"
            ]
          },
          "value": { "type": "string" },
          "level": { "enum": ["green", "yellow", "red", "unavailable"] },
          "reason": { "type": "string" },
          "as_of": { "type": "string" }
        }
      }
    },
    "mode": { "enum": ["full", "partial", "llm", "fallback", "llm_fallback"] },
    "confidence": { "enum": ["normal", "low"] },
    "active_signals": { "type": "integer" },
    "total_signals": { "type": "integer" },
    "form_applied": {
      "type": "object",
      "properties": {
        "category": { "type": ["string", "null"] },
        "dong": { "type": ["string", "null"] },
        "customer": { "type": "string" },
        "ages": { "type": "array", "items": { "type": "string" } },
        "risk": { "type": "string" }
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "ages": { "type": "array", "items": { "type": "string" } },
        "customer": { "type": "string" }
      }
    },
    "score": {
      "oneOf": [
        { "type": "number", "minimum": 0, "maximum": 100 },
        { "type": "null" }
      ]
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dong", "score", "why"],
        "properties": {
          "dong": { "type": "string" },
          "score": { "type": "number" },
          "why": { "type": "string" }
        }
      }
    },
    "trend": { "type": ["string", "null"] },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "period", "detail"],
        "properties": {
          "source": { "enum": ["D1", "D2", "D3", "D4", "D5", "D6", "D9", "D10"] },
          "period": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "map": {
      "type": "object",
      "required": ["layer", "highlight"],
      "properties": {
        "layer": { "enum": ["demand", "tourism", "supply", "footfall", "survival"] },
        "highlight": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
